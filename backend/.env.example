DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u731511898_hawupay
DB_USERNAME=u731511898_hawupay
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
HMAC_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# CORS Configuration (* untuk semua origin, atau pisahkan dengan koma: https://domain.com,https://admin.domain.com)
CORS_ORIGINS=*

# SMTP settings required for registration approval, email verification, and password recovery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:5173

# Local testing only: when SMTP is not configured, allow admins on loopback
# to approve an UMKM registration and receive the continuation link in the UI.
# Keep false/ unset in production. This never sends email.
UMKM_REGISTRATION_DEV_LINK=false

